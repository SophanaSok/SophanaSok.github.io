---
/* Hidden until the script un-hides it, so a reader without JavaScript is never
 * shown a control that cannot work. Both icons are hand-drawn on an integer
 * grid. SVG path syntax lets a decimal run on without a separator, so
 * optimizer output can produce a token the site's own no-version-literal check
 * reads as a pinned version. */
---
<button class="theme-toggle" id="theme-toggle" type="button" hidden aria-pressed="false">
  <span class="visually-hidden">Dark theme</span>
  <svg class="moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14a8 8 0 0 1-10-10 8 8 0 1 0 10 10z" />
  </svg>
  <svg class="sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2" />
  </svg>
</button>
