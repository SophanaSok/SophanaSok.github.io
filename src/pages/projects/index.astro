---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Block from '../../components/Block.astro';
import { RANKED } from '../../lib/site';
import { formatNumber } from '../../lib/format';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await getCollection('projects');
const studies = new Set((await getCollection('caseStudies')).map((s) => s.data.project));
const projects = all.sort((a, b) => {
  const t = Number(a.data.tier === 'secondary') - Number(b.data.tier === 'secondary');
  return t || (a.data.lens.swe?.rank ?? 99) - (b.data.lens.swe?.rank ?? 99);
});
---
<Base
  title="Projects"
  path="projects/"
  description="Every public project by Sophana Sok in one table: language, headline number and where to read the source, ranked by the lens you choose."
  og="projects"
  ogAlt="A terminal card listing Sophana Sok's public projects with their languages and headline numbers"
  kind="list"
  projects={projects}
  page="projects"
>
  <div class="shell">
    <header class="study-head">
      <p class="eyebrow"><span class="chip">{projects.length} public projects</span></p>
      <h1>Projects<span class="cursor" aria-hidden="true"></span></h1>
      <p class="lede">Every public project, ranked by the lens in the header. Hover a number for the command that produced it.</p>
    </header>
    <Block title="projects" n="all" id="table" class="section-block">
      <div class="ptable">
        {projects.map((p) => {
          const lenses = RANKED.filter((l) => p.data.lens[l]);
          const m = p.data.metrics[0];
          return (
            <div class="ptable-row lensed" data-lens={lenses.join(' ')} style={lenses.map((l) => `--o-${l}:${p.data.lens[l]!.rank}`).join(';')}>
              <p class="name">
                {studies.has(p.id) ? <a href={`${base}/projects/${p.id}/`}>{p.data.name}</a> : <a href={p.data.repo}>{p.data.name}</a>}
                <small>{p.data.language}{p.data.version && ` · v${p.data.version}`}</small>
              </p>
              <div class="what">
                {p.data.tagline}
                {lenses.map((l) => (
                  <p class="card-angle" data-for={l}>{p.data.lens[l]!.angle}</p>
                ))}
              </div>
              <p class="proof">
                <abbr title={m.how}>{formatNumber(m.value)}</abbr>
                <small>{m.label}</small>
              </p>
              <p class="go">
                {studies.has(p.id) && <a href={`${base}/projects/${p.id}/`}>case study →</a>}
                <a href={p.data.repo}>source ↗</a>
                {p.data.live && <a href={p.data.live}>live ↗</a>}
                {p.data.site && <a href={p.data.site}>site ↗</a>}
              </p>
            </div>
          );
        })}
      </div>
      <p class="note">Work without a public repository or a live URL is not listed.</p>
    </Block>
  </div>
</Base>
